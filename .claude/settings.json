{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run test:*)",
      "Bash(bun run verify:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run typecheck:edge)",
      "Bash(bun run lint:*)",
      "Bash(bun run build)",
      "Bash(bun run dev:local)",
      "Bash(bun run local:prepare)",
      "Bash(bun run local:start)",
      "Bash(bun run local:stop)",
      "Bash(bun run local:audit-schema)",
      "Bash(bunx vitest run:*)",
      "Bash(bunx playwright test:*)",
      "Bash(bunx eslint:*)",
      "Bash(bunx tsc --noEmit:*)",
      "Bash(node scripts/verify.mjs:*)",
      "Bash(npx --yes supabase@2.121.0 status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(scripts/worktree-new.sh:*)"
    ],
    "ask": [
      "Bash(bun run dev)",
      "Bash(bun run dev:rehearsal)",
      "Bash(bun run local:reset)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(node scripts/release-*)",
      "Bash(bash scripts/rehearsal-*)",
      "Bash(python3 scripts/rehearsal-*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(*supabase* db push*)",
      "Bash(*supabase* link*)",
      "Bash(*supabase* functions deploy*)",
      "Bash(*supabase* secrets set*)",
      "Bash(gh pr merge * --admin *)"
    ]
  }
}
